            "strategy": "uniform"
          }
        },

        "CUSTOMER_NUMBER": {
          "type": "identifier",
          "semantic": "customer_identifier",
          "length": 6,
          "prefix": "CUS",
          "nullable": false
        },

        "ACCOUNT_TYPE": {
          "type": "categorical",
          "semantic": "account_type",
          "values": [
            "STANDARD",
            "PREMIUM"
          ],
          "nullable": false,
          "generation": {
            "strategy": "uniform"
          }
        },

        "CUSTOMER_NAME": {
          "type": "string",
          "semantic": "name",
          "min_length": 5,
          "max_length": 30,
          "nullable": false
        }
      }
    }
  },

  "identity_generation": {
    "approaches": {
      "independent": {
        "description": "Generate each identity component independently and validate the resulting composite identity.",
        "strategy": "independent"
      },

      "coordinated": {
        "description": "Generate the composite identity as a coordinated unit and assign its components to the corresponding fields.",
        "strategy": "coordinated"
      }
    }
