{
  "experiment": {
    "id": "010",
    "name": "Composite Identity"
  },

  "generation": {
    "seed": 42,
    "record_count": 1000
  },

  "entities": {
    "CUSTOMER_ACCOUNT": {
      "identity": {
        "type": "composite",
        "fields": [
          "COMPANY_CODE",
          "CUSTOMER_NUMBER",
          "ACCOUNT_TYPE"
        ]
      },

      "fields": {
