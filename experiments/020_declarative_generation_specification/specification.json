  "rules": [
    {
      "id": "RULE-001",
      "name": "MIN_AMOUNT_LE_MAX_AMOUNT",
      "type": "CONSTRAINT",
      "expression": {
        "operator": "LESS_OR_EQUAL",
        "left": {
          "field": "ORDER.MIN_AMOUNT"
        },
        "right": {
          "field": "ORDER.MAX_AMOUNT"
        }
      }
    },

    {
      "id": "RULE-002",
      "name": "AMOUNT_WITHIN_BOUNDS",
      "type": "CONSTRAINT",
      "expression": {
        "operator": "BETWEEN",
        "value": {
          "field": "ORDER.AMOUNT"
        },
        "lower": {
          "field": "ORDER.MIN_AMOUNT"
        },
        "upper": {
          "field": "ORDER.MAX_AMOUNT"
        }
      }
    },

    {
      "id": "RULE-003",
      "name": "DISCOUNT_VALID_RANGE",
      "type": "CONSTRAINT",
      "expression": {
        "operator": "BETWEEN",
        "value": {
          "field": "ORDER.DISCOUNT"
        },
        "lower": 0,
        "upper": 30
      }
    },

    {
      "id": "RULE-004",
      "name": "SHIPMENT_AFTER_ORDER",
      "type": "CONSTRAINT",
      "expression": {
        "operator": "GREATER_OR_EQUAL",
        "left": {
          "field": "SHIPMENT.SHIPMENT_DATE"
        },
        "right": {
          "field": "ORDER.ORDER_DATE"
        }
      }
    },

    {
      "id": "RULE-005",
      "name": "DELIVERY_AFTER_SHIPMENT",
      "type": "CONSTRAINT",
      "expression": {
        "operator": "GREATER_OR_EQUAL",
        "left": {
          "field": "SHIPMENT.DELIVERY_DATE"
        },
        "right": {
          "field": "SHIPMENT.SHIPMENT_DATE"
        }
      }
    },

    {
      "id": "RULE-006",
      "name": "PREMIUM_HIGHER_CREDIT_LIMIT",
      "type": "CONDITIONAL",
      "expression": {
        "operator": "IMPLIES",
        "if": {
          "operator": "EQUALS",
          "left": {
            "field": "CUSTOMER.CUSTOMER_TYPE"
          },
          "right": "PREMIUM"
        },
        "then": {
          "operator": "GREATER_THAN",
          "left": {
            "field": "CUSTOMER.CREDIT_LIMIT"
          },
          "right": 5000
        }
      }
    },

    {
      "id": "RULE-007",
      "name": "LINE_AMOUNT_CALCULATION",
      "type": "DERIVED",
      "expression": {
        "operator": "MULTIPLY",
        "arguments": [
          {
            "field": "ORDER_ITEM.QUANTITY"
          },
          {
            "field": "ORDER_ITEM.UNIT_PRICE"
          }
        ]
      }
    },

    {
      "id": "RULE-008",
      "name": "NET_AMOUNT_CALCULATION",
      "type": "DERIVED",
      "expression": {
        "operator": "SUBTRACT",
        "arguments": [
          {
            "field": "ORDER.SUBTOTAL"
          },
          {
            "operator": "MULTIPLY",
            "arguments": [
              {
                "field": "ORDER.SUBTOTAL"
              },
              {
                "operator": "DIVIDE",
                "arguments": [
                  {
                    "field": "ORDER.DISCOUNT"
                  },
                  100
                ]
              }
            ]
          }
        ]
      }
    },

    {
      "id": "RULE-009",
      "name": "ACTIVE_PRODUCT_REQUIRED_FOR_ORDER_ITEM",
      "type": "CONDITIONAL",
      "expression": {
        "operator": "IMPLIES",
        "if": {
          "operator": "IS_NOT_NULL",
          "field": "ORDER_ITEM.PRODUCT_ID"
        },
        "then": {
          "operator": "EQUALS",
          "left": {
            "field": "PRODUCT.IS_ACTIVE"
          },
          "right": true
        }
      }
    }
  ],

